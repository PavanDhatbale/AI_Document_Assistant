# ==============================================================================
# AI DOCUMENT ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before running the application.
# DO NOT COMMIT SENSITIVE VALUES OR REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# --- Server Configuration ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Relational Database (MySQL 8+) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_doc_assistant
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# --- Security & JWT Authentication ---
# Generate a secure 256-bit (32-byte) hex or base64 secret for HMAC-SHA256
JWT_SECRET=your_base64_encoded_256_bit_secret_key_change_me_in_production
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Gemini LLM & Embeddings ---
# Obtain your key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Recommended official Gemini embedding model (text-embedding-004 was shut down in Jan 2026)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Explicit output dimension via Matryoshka Representation Learning (MRL); must match QDRANT_VECTOR_SIZE
GEMINI_EMBEDDING_DIMENSION=768

# --- Qdrant Vector Database ---
# For local Docker instance: Host localhost, gRPC port 6334, REST port 6333
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_embeddings
# Vector dimension must strictly match GEMINI_EMBEDDING_DIMENSION (768)
QDRANT_VECTOR_SIZE=768
QDRANT_USE_TLS=false
QDRANT_ENABLED=true
QDRANT_TIMEOUT_SECONDS=30
QDRANT_UPSERT_BATCH_SIZE=64

# --- Document Storage & Ingestion Limits ---
# Path relative to backend root or absolute filesystem path
UPLOAD_STORAGE_DIR=./storage/uploads
MAX_FILE_SIZE_MB=25
MAX_FILE_SIZE_BYTES=26214400
MAX_REQUEST_SIZE_MB=30
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- RAG Retrieval & Chat Parameters ---
RAG_TOP_K_CHUNKS=4
# Configurable similarity threshold; calibrate against domain evaluation test set
RAG_SIMILARITY_THRESHOLD=0.65
GEMINI_CHAT_MODEL=gemini-3.8-flash
RAG_TEMPERATURE=0.2
RAG_MAX_OUTPUT_TOKENS=2048
RAG_MAX_MESSAGE_LENGTH=4000
STALE_PROCESSING_TIMEOUT_MINUTES=15

# --- Frontend Environment Variables (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api
