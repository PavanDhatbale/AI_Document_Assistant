# Frontend Environment Variables
# NOTE: All VITE_* variables are exposed to the client-side browser bundle.
# NEVER store secrets, private keys, database passwords, or JWT secrets here.

# Spring Boot Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Client-side Maximum File Size in Bytes (default: 25MB = 26214400 bytes)
VITE_MAX_FILE_SIZE_BYTES=26214400

# Client Session Storage Strategy: 'session' (default, tab-scoped) or 'memory' (cleared on page reload)
VITE_AUTH_STORAGE_MODE=session
